<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="index, follow">
  <meta name="theme-color" content="#1a2837">
  
  <title><%= title ? `${title} - CS2D Server List` : 'CS2D Server List' %></title>
  
  <% if (description) { %>
  <meta name="description" content="<%= description %>">
  <% } %>
  
  <link rel="icon" href="/favicon.ico">
  <link rel="canonical" href="https://cs2d.pp.ua<%= url %>">
  
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link rel="dns-prefetch" href="https://cdn.jsdelivr.net">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/inter-ui@4.1.0/inter.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/styles.css?v=<%= style %>">
  
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="CS2D Server List">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content="<%= title ? `${title} - CS2D Server List` : 'CS2D Server List' %>">
  <meta property="og:url" content="https://cs2d.pp.ua<%= url %>">
  <meta property="og:image" content="https://cs2d.pp.ua/ogimage.jpg">
  <meta property="og:image:width" content="616">
  <meta property="og:image:height" content="353">
  <% if (description) { %>
  <meta property="og:description" content="<%= description %>">
  <% } %>
  
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= title ? `${title} - CS2D Server List` : 'CS2D Server List' %>">
  <meta name="twitter:image" content="https://cs2d.pp.ua/capsule_main_616x353.jpg">
  <% if (description) { %>
  <meta name="twitter:description" content="<%= description %>">
  <% } %>
</head>
<body>
  <nav>
    <a href="/" aria-label="Servers">
      <i class="bi bi-hdd-stack-fill" aria-hidden="true"></i>
      <span>Servers</span>
    </a>
    <a href="/stats" aria-label="Statistics">
      <i class="bi bi-clipboard-data-fill" aria-hidden="true"></i>
      <span>Stats</span>
    </a>
    <a href="/maps" aria-label="Maps">
      <i class="bi bi-map-fill" aria-hidden="true"></i>
      <span>Maps</span>
    </a>
    <a href="/tools" aria-label="Tools">
      <i class="bi bi-wrench" aria-hidden="true"></i>
      <span>Tools</span>
    </a>
  </nav>

  <main role="main">
    <%- body %>
  </main>

  <footer role="contentinfo">
    <a href="/api">API Docs</a>
    <a href="#" aria-label="Scroll to top">Scroll To Top</a>
    <a href="https://github.com/ernestpasnik/cs2d-serverlist/" target="_blank" rel="noopener noreferrer">GitHub</a>
  </footer>

  <script defer src="https://cdn.jsdelivr.net/gh/tofsjonas/sortable@4.0.1/dist/sortable.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/tippy.js@6.3.7/dist/tippy-bundle.umd.min.js"></script>
  <script defer src="/scripts.js?v=<%= script %>"></script>
</body>
</html>